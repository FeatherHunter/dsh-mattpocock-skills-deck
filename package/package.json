{
  "name": "dsh-mattpocock-skills-deck",
  "version": "1.7.51",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeatherHunter/dsh-mattpocock-skills-deck.git"
  },
  "description": "安装即自带mattpocock/skills v1.3.1的27个工程与效率技能，无需手动装技能。400亿token打造本插件，在原始技能之上提供10倍的开发效率，也能帮助新手更快上手该技能套件。全力支持GitHub issue；Markdown为预览版；GitLab暂不支持。感谢您的使用和支持💗",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node ../scripts/build.mjs --pkg-only",
    "prepare": "node ../scripts/build.mjs --pkg-only"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./tools": "./lib/platform/deckToolsRow.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-plugin-update": "^0.9.0"
  },
  "files": [
    "lib",
    "shared",
    "cordis.patch.yml",
    "bundled-skills",
    "scripts/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "mattpocock",
    "skills",
    "wayfinder",
    "triage",
    "grilling",
    "handoff",
    "issue-tracker",
    "deck"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "homepage": "https://github.com/FeatherHunter/dsh-mattpocock-skills-deck",
  "license": "MIT"
}
