{
  // 契约层的 TypeScript 类型检查配置：只检查不产出。
  // 这一层是纯类型（接口与形状），**没有任何运行时实现**：真正的 JS 由各房与 contract.js
  // 继续承担，等迁移批次把它们换过来。所以这里不需要 esbuild 转译步骤，也没有派生产物。
  //
  // 与四个计算核（src/shared/label-color/ 等）的差别只有一处：本文件要多给一个 DOM 库。
  // 原因是契约里会出现 AbortSignal（中止信号）与 setTimeout（定时器）这两个类型，
  // 它们由 DOM 库提供；Node 侧的同名能力与这里声明的是同一形状，不需要再引 @types/node。
  "compilerOptions": {
    // 混编开关（#1020 开）：跟着类型检查一起跑的还有契约目录里那些旧语言文件。allowJs 让它们进得来——
    // 项目里有 .ts 直接引用旧语言文件时，关着开关的配置会当场报「找不到模块」，这是我们要的报警，不是噪音。
    // checkJs 保持关闭：旧语言文件不做类型检查（它们本来就没标注），只保证「引入得到」，转换逐个文件做。
    // 等这个目录里的旧语言文件清零，把这两行摘掉；验收由 scripts/typecheck.mts 的覆盖对账负责。
    "allowJs": true,
    "checkJs": false,
    // 保守目标：宿主（Node）与客户端闭包两边都跑得动，与四个核同一套保证。
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 只做类型检查不产出（这一层没有运行时实现可产出）。
    "noEmit": true,
    "strict": true,
    // 不引任何 @types 包：类型只用语言自带的标准写法，不依赖特殊编译选项。
    "types": [],
    "skipLibCheck": true
  },
  // 只圈契约目录与三份契约相邻的纯模块：别的目录还没转过来，圈进来会当场红一片（那是迁移批次的事）。
  // 三份是 #1026 从契约目录搬出来的行为（票身份 identity-keys.ts、名单派生 label-names.ts、
  // 修复拼装 fix-contract.ts）：它们全标注、严格干净，暂住这份严格配置里，直到迁移批次带来
  // 整棵 src/tracker 的归属配置；契约门禁的第四项只扫契约目录本身，所以行为文件住在这里
  // 不会触发「只许类型与数据」那条（那条不管目录外）。
  "include": [
    "src/tracker/contract/**/*.ts",
    "src/tracker/identity-keys.ts",
    "src/tracker/label-names.ts",
    "src/tracker/fix-contract.ts",
    // #1111：判档规则表是这一票的核心模块，全标注、严格干净，与上面三份同样暂住这里。
    // 它只 import 契约层的 vocabulary.ts，不会把没标注的旧语言文件拉进这次检查。
    "src/tracker/error-rules.ts",
    // #1111：markdown 房的失败构造辅助（failFromError / failAs / …）。它只 import 跟踪器层的
    // preflight.ts 与 error-rules.ts，两份都已全标注；同批的 GitHub / GitLab 房仍按「先修后转」
    // 在原地是旧语言文件，所以这一批只圈这一份，等整棵 src/tracker 的归属配置（#1095）来了再收口。
    "src/tracker/rooms/markdown/error-fail.ts"
  ]
}
