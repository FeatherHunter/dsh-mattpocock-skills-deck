+  try { dispose.dispose() } catch (e) {}
+  try { fs.rmSync(rootA, { recursive: true, force: true }) } catch (e) {}
+  console.log('\n' + (failed ? '存在失败' : '全部通过 — #1090（' + total + ' 条）'))
+  process.exit(failed ? 1 : 0)
+}
+
