{
  "name": "dsh-mattpocock-skills-deck",
  "version": "1.9.0-beta.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/FeatherHunter/dsh-mattpocock-skills-deck.git"
  },
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/generate-time-config.mjs --check && node scripts/typecheck.mts",
    "update:latest": "pnpm update dsh-plugin-update@^0.18.25 && node scripts/derive-update-from-package.mjs && node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "npm run typecheck && node scripts/build.mjs && node scripts/verify-chain.js && npm run test:smoke",
    "smoke": "node --import ./scripts/ts-hook.mjs tests/smoke-client.test.ts && node --import ./scripts/ts-hook.mjs tests/smoke-host-dispatch.test.ts && node --import ./scripts/ts-hook.mjs tests/smoke-render.test.ts && node --import ./scripts/ts-hook.mjs tests/smoke-naming-persistence.test.ts && node --import ./scripts/ts-hook.mjs tests/smoke-comment-passthrough.test.ts",
    "test:smoke": "node scripts/verify-chain.js --script smoke",
    "test:nobuild": "node scripts/verify-chain.js && npm run test:smoke",
    "verify:parallel": "node scripts/verify-parallel.mjs --keep-going",
    "verify:fast": "node scripts/verify-parallel.mjs --tier fast",
    "verify:changed": "node scripts/verify-parallel.mjs --changed",
    "verify": "node scripts/verify-chain.js",
    "sync:matt": "node scripts/sync-matt-skills.mjs --pin v1.3.1 --verify"
  },
  "dependencies": {
    "dsh-log": "^0.3.4",
    "dsh-plugin-update": "^0.18.25",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "dependency-cruiser": "^18.6.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dsh": {
    "bundle": {
      "mode": "patch",
      "patch": "./package/cordis.patch.yml"
    }
  }
}
