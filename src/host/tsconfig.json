{
  // src/host 域的类型检查配置（#1155）。
  //
  // 这份配置回答一个问题：宿主这一片目录里每一份源码，都真的被编译器看过一遍吗？
  // 不写它，文件就落在所有配置的 include 之外——类型检查会全绿，而这些文件一次都没被检查过
  // （#1020 要治的那个病：编译器看不见的文件不会报错，只会安静地不检查）。
  //
  // 来历：src/host 是最后一片没有自己配置的域。到 2026-10-14 为止，这片目录里 57 份手写
  // JavaScript 在往 TypeScript 走的路上留下了 13 份 .ts，它们谁也没检查过：scripts/typecheck.mts
  // 的缺口断言逐条把它们报成失败，而 npm test 的第一段就是那条检查。这份配置落地之前，
  // 13 份文件报 356 条严格模式错误——不是新出现的错，是一直被藏着的账（同 #1148 的病）。
  //
  // 覆盖对账的口径与 src/deck、src/tracker 一致：include 只声明本域目录，顺着 import 看到的
  // src/shared、src/tracker 那几份不算「越界吸收」，也不算「重复归属」——归属只认 include 声明。
  "compilerOptions": {
    // 纯 TypeScript（2026-10-20 收尾）：本域旧语言文件已经清零，混编开关（allowJs/checkJs）摘掉。
    // 与其余几份域配置同一套保守保证：目标降到 ES2020，浏览器闭包与 Node 宿主两边都跑得动。
    "target": "ES2020",
    // 比四个核多一份 DOM：宿主这一片要认 AbortSignal、定时器与 fetch 这几个类型，
    // 声明的是与别处同一件事，不额外引类型包。
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 只做类型检查不产出：真正的 JS 由 scripts/build.mts 经 esbuild 转译生成。
    "noEmit": true,
    // strict 开着是有意的：这一域标注得起，能严格标注才说明「转换完成」不是嘴上说的。
    "strict": true,
    // 不挂任何类型包（本仓没有装 @types/node，其余配置也都是空数组）。宿主确实要读 process.cwd()
    // 这类全局量，但那几处是按「可能不存在」写的（typeof process !== 'undefined' 守着），
    // 所以类型也照实声明成可能缺席，写在用它的那几个文件里，而不是挂一份 Node 类型把全局打开。
    "types": [],
    "skipLibCheck": true
  },
  // include 只写目录通配，不点名文件清单：新增的文件自动进检查，不必有人记得去别处登记。
  // 「一个文件只属于一个域目录」这条与 scripts/typecheck.mts 的覆盖对账是同一条约定（#1098 第 5 条）。
  "include": ["**/*.ts"]
}
