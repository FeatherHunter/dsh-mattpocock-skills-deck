{
  // 刷新机制新家的 TypeScript 配置（#1425 建）：纯逻辑核与契约层搬进 src/refresh/ 之后，
  // 这 58 份真源的类型检查归这一份配置管（#1425 二十份内核与契约，#1426 十份宿主房，
  // #1427 十八份取数链与桥加登记层两份桥，#1428 九份客户端房）。旧的两份配置（src/shared/refresh、src/shared/host-timer）
  // 随着最后一批源码搬出而删除 —— 一个文件只属于一份配置，旧配置留着会因圈住 0 个文件而触发门禁。
  // rooms/host、rooms/client、registry 三个目录现在还是空的（住户 #1426-#1428 才搬进来），
  // 通配先圈上，住户搬进来的那一票不用再动配置。
  "compilerOptions": {
    // 输出目标定死保守版本：Node 宿主与浏览器闭包两边都跑得动（与原来两份配置同一套保证）。
    "target": "ES2020",
    // host-timer 那份带来的 DOM 库：判句柄是不是可调用、数字句柄那一档交回全局 clearTimeout，
    // 那两个全局名字由 DOM 库提供（只是类型声明，Node 侧同名能力的形状一致，不需要再引 @types/node）。
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 只做类型检查不产出：真正的 JS 由 scripts/build.mts 经 esbuild 转译生成。
    "noEmit": true,
    "strict": true,
    // 核心里不碰任何 Node 或浏览器专属能力，读写全在外面（适配器）。
    // 类型只用标准写法，不依赖特殊编译选项。
    "types": [],
    "skipLibCheck": true
  },
  "include": ["contract/**/*.ts", "kernel/**/*.ts", "rooms/**/*.ts", "registry/**/*.ts"]
}
