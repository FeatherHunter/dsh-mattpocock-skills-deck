{
  // src/deck 域的类型检查配置。
  //
  // 这份配置回答一个问题：deck 这片目录里每一份源码，都真的被编译器看过一遍吗？
  // 不写它（或圈得太窄），文件就落在所有配置的 include 之外——类型检查会全绿，而这些文件
  // 一次都没被检查过（那正是 #1020 要治的病：编译器看不见的文件不会报错，只会安静地不检查）。
  //
  // 来历：#1039 先为拆出来的纯规则层 rules/ 建了这份配置，只圈 rules/**；#1107 把它放宽到
  // 整片域，shell/ 与 registration/、tools/ 那 28 份文件从此进检查。
  //
  // 放宽之后检查会顺着 import 走进 src/tracker（deck 有 3 处引它：读地图正文的 body-parse、
  // 投影派生的 deck-derive、判断后端的 backendDecision）。那 4 份文件是 JSDoc 时代的老代码，
  // 严格模式下有 118 条错误——这是 tracker 域自己的欠账，不是本域放宽造成的；放在这里是为了
  // 让「有人检查过」与「检查通过」两件事分开记，前者的结论现在是真的。
  "compilerOptions": {
    // 混编开关（#1020 开）：跟着类型检查一起跑的还有本域里那些旧语言文件。allowJs 让它们进得来——
    // 本域里有 .ts 直接引用旧语言文件时，关着开关的配置会当场报「找不到模块」，这是我们要的报警，
    // 不是噪音。checkJs 保持关闭：旧语言文件不做类型检查（它们本来就没标注），只保证「引入得到」，
    // 转换逐个文件做。等本域里的旧语言文件清零，把这两行摘掉。
    "allowJs": true,
    "checkJs": false,
    // 与更新核心那边同一套保守保证：Node 宿主与浏览器闭包两边都跑得动。
    "target": "ES2020",
    // 比四个核多一份 DOM：本域有一部分文件要认 AbortSignal 与定时器这两个类型（宿主侧执行同一个
    // 形状，这里声明的是同一件事，不额外引 @types/node）。
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 只做类型检查不产出：真正的 JS 由 build.mjs 经 esbuild 转译生成。
    "noEmit": true,
    // strict 开着是有意的：这一域从纯规则到工具入口全部标注得起。能严格标注说明「转换完成」
    // 不是嘴上说的——真转干净了的代码，不需要为了过检查去放宽任何一条编译选项。
    "strict": true,
    // 本域不碰任何宿主专属能力，所以不挂任何类型包：类型只用语言自带的标准写法。
    "types": [],
    "skipLibCheck": true
  },
  // include 只写目录通配，不点名文件清单：新增的文件自动进检查，不必有人记得去别处登记。
  // 「一个文件只属于一个域目录」这条与 scripts/typecheck.mts 的覆盖对账是同一条约定（#1098 第 5 条）。
  "include": ["**/*.ts"]
}
