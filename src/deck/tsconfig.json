{
  // src/deck/rules 的类型检查配置（票 #1039 立：这个目录是这次拆出来的纯规则层）。
  //
  // 这个配置的用途只有一个：让 scripts/typecheck.mts 的对账能看见这一层。
  // 它回答「这一层的每个文件都真的被编译器看过一遍吗」——不写它，这些文件就落在任何
  // 配置的 include 之外，类型检查会全绿而这层一次都没被看过（那正是 #1020 要治的病）。
  //
  // strict 开着是有意的：这一层是纯计算，没有宿主、没有文件、没有时钟，全部标注得起。
  // 它也是这次拆分想要的东西之一：能严格标注，说明「纯」不是嘴上说的——真纯的代码不需要
  // 为了过检查去放宽任何一条编译选项。
  "compilerOptions": {
    // 与更新核心那边同一套保守保证：Node 宿主与浏览器闭包两边都跑得动。
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 只做类型检查不产出：真正的 JS 由 build.mjs 经 esbuild 转译生成。
    "noEmit": true,
    "strict": true,
    // 这一层不碰任何宿主专属能力（不改文件、不起进程、不读时钟、不发请求），所以不挂任何类型包。
    "types": [],
    "skipLibCheck": true
  },
  "include": ["rules/**/*.ts"]
}
