{
  // 混编开关（#1020 开）：跟着类型检查一起跑的还有域里那些旧语言文件。allowJs 让它们进得来——
  // 项目里有 .ts 直接引用旧语言文件时，关着开关的配置会当场报「找不到模块」，这是我们要的报警，不是噪音。
  // checkJs 保持关闭：旧语言文件不做类型检查（它们本来就没标注），只保证「引入得到」，转换逐个文件做。
  // 等这个域里的旧语言文件清零，把这两行摘掉；验收由 scripts/typecheck.mts 的覆盖对账负责。
  "allowJs": true,
  "checkJs": false,
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
