{
  // 纯 TypeScript（2026-10-20 收尾）：全仓不再有手写 JavaScript，所有共享域都不开混编开关。
  // 其余与各共享域同一套保证：目标 ES2020、严格模式、只做类型检查不产出（转译走 scripts/build.mts 的 esbuild）。
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    // 纯数据域，不碰任何 Node 或浏览器专属能力。
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
