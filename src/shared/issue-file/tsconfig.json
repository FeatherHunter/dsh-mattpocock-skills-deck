{
  // 纯 TypeScript：本域只做字符串判定，不碰 Node 或浏览器专属能力。
  "compilerOptions": {
    // 输出目标与其它共享域同一套保证：Node 宿主与浏览器闭包两边都跑得动。
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 只做类型检查不产出：真正的 JS 由 scripts/build.mts 经 esbuild 转译生成。
    "noEmit": true,
    "strict": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
