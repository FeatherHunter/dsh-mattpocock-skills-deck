{
  // 外部命令收尾域的 TypeScript 配置（#1392）。
  // 这个域只住一份共用代码：插件运行实例被宿主销毁时，一条还在飞的外部命令怎么收尾
  // （名额归还幂等、放弃子进程、建等待计时器时的实例销毁守卫）。域的骨架与另外几个域一致：
  // 手写真源在 src/ 子目录，构建把 src/*.ts 逐份转译进仓库根的 .build/shared/<域>/
  // （scripts/build.mts 的 findDomains 按「这个目录里有 tsconfig.json」认域，新增域不需要另外登记清单）。
  "compilerOptions": {
    // 输出目标定死保守版本：Node 宿主与浏览器闭包两边都跑得动（与 host-timer 同一套保证）。
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 只做类型检查不产出：真正的 .js 由 scripts/build.mts 经 esbuild 转译生成（产物不在源码树里）。
    "noEmit": true,
    "strict": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
