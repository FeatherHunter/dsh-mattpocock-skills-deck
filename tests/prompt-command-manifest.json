    { "id": "issue-list", "what": "列出票", "pattern": "(?:gh|glab)\\s+issue\\s+list", "movedTo": "deck_context", "why": "列票与看地图都走工具" },
    { "id": "issue-comment", "what": "在票上发评论", "pattern": "(?:gh|glab)\\s+issue\\s+(?:comment|note)", "movedTo": "deck_issue_patch", "why": "评论已经搬进工具" },
    { "id": "issue-label", "what": "改一张票的标签", "pattern": "(?:gh|glab)\\s+issue\\s+(?:edit|update)[^\\n]{0,60}--(?:add|remove)-label", "movedTo": "deck_issue_patch", "why": "补标签已经搬进工具" },
    { "id": "issue-close", "what": "关闭一张票", "pattern": "(?:gh|glab)\\s+issue\\s+close", "movedTo": "deck_issue_patch", "why": "关闭已经搬进工具" },
    { "id": "issue-body", "what": "改票的正文", "pattern": "(?:gh|glab)\\s+issue\\s+(?:edit|update)[^\\n]{0,60}--body-file", "movedTo": "deck_issue_patch", "why": "改正文已经搬进工具（写完由工具读回核对）" },
    { "id": "issue-assign", "what": "认领（指派人）", "pattern": "(?:gh|glab)\\s+issue\\s+(?:edit|update)[^\\n]{0,60}--add-assignee", "movedTo": "deck_issue_patch", "why": "认领＝指派人，已经搬进工具" },
