    { "id": "backend:markdown", "kind": "prompt", "path": "src/host/tracker/backends/markdown/index.js", "what": "本地 Markdown 后端自己声明的提示词与修复指引" },
    { "id": "doc:issue-tracker", "kind": "doc", "path": "docs/agents/issue-tracker.md", "what": "本仓库的跟踪器说明（技能与 AI 都读它）" },
    { "id": "doc:template-github", "kind": "doc", "path": "package/bundled-skills/setup-matt-pocock-skills/issue-tracker-github.md", "what": "随包发给用户的 GitHub 版跟踪器模板" }
