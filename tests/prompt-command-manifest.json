    { "id": "tracker-passthrough", "what": "包内写回脚本 / 让 AI 去解析插件安装目录那套间接写法", "pattern": "(?:dsh\\s+plugin|require\\.resolve|fix-issue-body\\s*\\.\\s*mjs|wire-subissues\\s*\\.\\s*mjs)", "movedTo": "", "why": "这两条脚本的活已经由工具承担，提示词与文档一个都不许再引用" }
