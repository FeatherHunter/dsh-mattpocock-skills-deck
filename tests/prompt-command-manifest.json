    { "id": "label-color", "what": "改标签颜色的命令行", "pattern": "(?:gh|glab)\\s+label\\s+(?:edit|list|create)", "movedTo": "", "evidence": "改色弹窗", "why": "标签配色由面板的改色弹窗按契约层那两条操作自己写，提示词不教命令；这一条的「改成什么」就写在 evidence 那句里" },
